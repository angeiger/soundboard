{
  // Tests are checked on their own because some deliberately import from both
  // sides of the process boundary (the accelerator agreement test loads main's
  // hotkeys and the renderer's recorder together), which the composite
  // main/renderer projects each refuse.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // The renderer's module declarations -- Vite's client types, and the RNNoise
  // virtual module -- which renderer code the tests load relies on.
  "include": ["src/**/*.test.ts", "src/renderer/src/env.d.ts", "src/renderer/src/virtual.d.ts"]
}
